{
  "version": "pdp.config/v3",
  "revision": "minimal-v1",
  "transport": {
    "unix_socket": "/run/pdp/pdp.sock",
    "socket_mode": "0660"
  },
  "upstreams": [
    {
      "host": "api.github.com",
      "binding": "github-local"
    }
  ],
  "credentials": {
    "providers": {
      "github": {
        "script_file": "adapter.star"
      }
    },
    "bindings": {
      "github-local": {
        "provider": "github",
        "secrets": {
          "token": {
            "file": "/run/secrets/github-token"
          }
        }
      }
    }
  },
  "policy": {
    "modules": ["policy.rego"]
  }
}
