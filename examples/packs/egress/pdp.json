{
  "version": "pdp.config/v3",
  "revision": "egress-v1",
  "transport": {
    "unix_socket": "/run/pdp/pdp.sock",
    "socket_mode": "0660"
  },
  "interception": {
    "certificate_file": "/etc/pdp/ca/tls.crt",
    "key_file": "/etc/pdp/ca/tls.key"
  },
  "upstreams": [
    {
      "host": "db.internal.example.com",
      "port": 5432,
      "tls": "tunnel"
    }
  ],
  "credentials": {
    "providers": {},
    "bindings": {}
  },
  "policy": {
    "modules": ["policy.rego"]
  }
}
