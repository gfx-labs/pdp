#!/bin/sh
# Build the PDP image from this checkout. The tag is the commit.
#
#   scripts/build-image          build into the local image store
#   scripts/build-image --push   build, push to the registry and print the digest
#
# .github/workflows/image.yml runs the second form on the self-hosted runners.
# Nothing else pushes.
set -eu

cd "$(dirname "$0")/.."

if [ -n "$(git status --porcelain)" ]; then
  echo "build-image: the checkout has uncommitted changes, so a commit would not name what was built" >&2
  exit 1
fi

image="ghcr.io/gfx-labs/pdp:$(git rev-parse --short=12 HEAD)"
output=--load
if [ "${1:-}" = --push ]; then
  output=--push
fi

docker buildx build --platform linux/amd64 -f containers/pdp/Dockerfile -t "$image" "$output" .
echo "$image"
if [ "$output" = --push ]; then
  digest="$(docker buildx imagetools inspect --format '{{.Manifest.Digest}}' "$image")"
  echo "${image%%:*}@$digest"
fi
