{
  "revision": "restricted-example-1",
  "operations": [
    {
      "id": "getIssue",
      "provider": "github",
      "classification": "read",
      "reviewed": true,
      "schema_digest": "sha256:replace-with-reviewed-schema-digest",
      "resources": [
        {"type": "repository", "source": "path", "components": [["owner"], ["repo"]]},
        {"type": "issue", "source": "path", "path": ["issue_number"]}
      ]
    }
  ],
  "grants": [
    {
      "id": "selected-issues-read",
      "scope": {
        "identities": ["uid:1000"],
        "providers": ["github"],
        "bindings": ["github-work"]
      },
      "mode": "read",
      "constraints": {
        "repositories": ["gfx-labs/pdp"],
        "issues": ["1", "2"]
      }
    }
  ],
  "mandatory": [
    {
      "id": "reviewed-schema-only",
      "scope": {"providers": ["github"]},
      "constraints": {
        "schema_digests": ["sha256:replace-with-reviewed-schema-digest"]
      }
    }
  ],
  "denies": [
    {
      "id": "issue-2-temporarily-blocked",
      "scope": {"providers": ["github"]},
      "constraints": {"issues": ["2"]}
    }
  ]
}
